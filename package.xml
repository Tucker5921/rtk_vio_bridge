<?xml version="1.0"?>
<package format="3">
  <name>rtk_vio_bridge</name><version>0.1.0</version>
  <description>Experimental RTK anchoring and relative VIO handover, not an EKF.</description>
  <maintainer email="tucker@example.com">tucker</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
